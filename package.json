{
  "name": "trainslator",
  "version": "0.1.0",
  "private": true,
  "description": "Translate EPUB books with AI, learning from existing human translations.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file-if-exists=.env scripts/live-smoke.ts",
    "test:corpus": "node scripts/corpus.ts",
    "translate:dev": "node --env-file-if-exists=.env scripts/translate-dev.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "htmlparser2": "^12.0.0",
    "openai": "^7.30.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "saxes": "^6.0.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
