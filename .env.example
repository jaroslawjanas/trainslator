# Copy this file to .env and fill in what you need. .env is not committed.

# Port of the API server (the web UI dev server runs on 5173 and proxies /api here).
PORT=5174

# Where projects, books, knowledge bases and logs are stored. Defaults to ./data.
TRAINSLATOR_DATA_DIR=
# Set to 1 to save full request and response bodies of every AI call in
# data/projects/<id>/logs/calls/ (large; contains book text).
TRAINSLATOR_LOG_BODIES=

# API keys can be stored here and referenced by name in Settings → Connections
# ("Environment variable"), instead of pasting them into the UI.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
